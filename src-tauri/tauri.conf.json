{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowManager",
  "version": "1.3.1",
  "identifier": "com.flowmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowManager",
        "width": 540,
        "height": 620,
        "minWidth": 540,
        "minHeight": 620,
        "resizable": false,
        "center": true,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "extensions"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MTU2NUM2MzhCODJCRDIKUldUU0s3ZzR4bVVWcVN5VHRES2kyOGhZeERQY0lxSFVBTDllQ050Nk5rVmM5dm9ndXo1S0ZzTTgK",
      "endpoints": [
        "https://github.com/amuwafiq29/flow-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
